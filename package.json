{
  "name": "elts-photography",
  "version": "2.2.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --import=tsx --test tests/*.test.ts",
    "seed:validation": "node --conditions=react-server --import=tsx --env-file=.env.local scripts/seed-validation.ts",
    "migrate": "node scripts/migrate.mjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "verify:remote": "node scripts/verify-remote.mjs",
    "verify:sql": "node scripts/verify-consolidated-sql.mjs",
    "seed:broadcast": "node scripts/seed-broadcast-project.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "class-variance-authority": "0.7.1",
    "cloudinary": "^2.11.0",
    "clsx": "2.1.1",
    "lucide-react": "1.47.0",
    "next": "16.3.5",
    "pdf-lib": "^1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
